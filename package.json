{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@google/genai": true,
    "esbuild": true,
    "protobufjs": true
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "diagnose": "node scripts/diagnose-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run diagnose && npm run typecheck && npm run lint && npm run build",
    "start": "node .vercel/output/functions/__server.func/index.mjs",
    "lint": "eslint . --rule 'prettier/prettier: off'",
    "format": "prettier --write ."
  },