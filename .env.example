REEL_ANALYTICS_SECRET=


# ==================================================
# AI / RAG (server-only feature flags)
# ==================================================
AI_RAG_ENABLED=false
AI_LOGGING_ENABLED=true
AI_SESSION_HASH_SALT=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Require TOTP before opening the Control Room. Enable only after admins have enrolled.
VITE_ADMIN_MFA_REQUIRED=false
