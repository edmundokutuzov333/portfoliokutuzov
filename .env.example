UNIFIED_NEWSLETTER_ENABLED=
NEWSLETTER_RATE_LIMIT_SALT=

# Phase 6 — keep analytics disabled until reel_analytics migration and backup gate are confirmed
REEL_ANALYTICS_ENABLED=false
